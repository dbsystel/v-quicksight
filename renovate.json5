{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    ":combinePatchMinorReleases",
    ":prConcurrentLimit10",
    ":prHourlyLimitNone",
    ":rebaseStalePrs",
    ":separateMultipleMajorReleases",
    ":automergeAll",
    ":automergePr",
  ],
  dependencyDashboard: {
    autoclose: true,
    labels: ["renovate"],
  },
  labels: ["Renovate"],
  postUpdateOptions: ["npmDedupe"],
  platformAutomerge: true,
  autodiscover: true,
  lockFileMaintenance: {
    enabled: true,
    platformAutomerge: true,
    automerge: true,
    schedule: ["after 11am and before 12pm"],
  },
  packageRules: [],
}
